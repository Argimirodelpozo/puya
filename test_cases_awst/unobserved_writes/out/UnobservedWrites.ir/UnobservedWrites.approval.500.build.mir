// Op                                                Stack (out)
// Effects::UnobservedWrites.approvalProgram() -> uint64:
subroutine main:
    main_block@0:
        txn ApplicationID                            tmp%0#0
        v-store tmp%0#0
        v-load tmp%0#0                               tmp%0#0
        bz main_if_body@1 ; b main_after_if_else@2

    main_if_body@1:
        int 1                                        1
        return

    main_after_if_else@2:
        txna ApplicationArgs 0                       tmp%2#0
        v-store tmp%2#0
        v-load tmp%2#0                               tmp%2#0
        btoi                                         which#0
        v-store which#0
        txna ApplicationArgs 1                       tmp%4#0
        v-store tmp%4#0
        v-load tmp%4#0                               tmp%4#0
        btoi                                         x#0
        v-store x#0
        v-load which#0                               which#0
        bz main_if_body@3 ; b main_after_if_else@4

    main_if_body@3:
        byte "box"                                   "box"
        byte 0x01                                    "box",0x01
        box_put
        byte "box"                                   "box"
        byte 0x0202                                  "box",0x0202
        box_put
        b main_after_if_else@4

    main_after_if_else@4:
        v-load which#0                               which#0
        int 1                                        which#0,1
        ==                                           tmp%7#0
        v-store tmp%7#0
        v-load tmp%7#0                               tmp%7#0
        bz main_after_if_else@6 ; b main_if_body@5

    main_if_body@5:
        v-load x#0                                   x#0
        int 2                                        x#0,2
        /                                            tmp%9#0
        v-store tmp%9#0
        v-load tmp%9#0                               tmp%9#0
        itob                                         tmp%10#0
        v-store tmp%10#0
        byte "box"                                   "box"
        v-load tmp%10#0                              "box",tmp%10#0
        box_put
        byte "box"                                   "box"
        box_del                                      {box_del}
        pop 1
        b main_after_if_else@6

    main_after_if_else@6:
        v-load which#0                               which#0
        int 2                                        which#0,2
        ==                                           tmp%11#0
        v-store tmp%11#0
        v-load tmp%11#0                              tmp%11#0
        bz main_after_if_else@8 ; b main_if_body@7

    main_if_body@7:
        global CurrentApplicationAddress             tmp%12#0
        v-store tmp%12#0
        v-load tmp%12#0                              tmp%12#0
        min_balance                                  before#0
        v-store before#0
        byte "box"                                   "box"
        byte 0x01                                    "box",0x01
        box_put
        global CurrentApplicationAddress             tmp%14#0
        v-store tmp%14#0
        v-load tmp%14#0                              tmp%14#0
        min_balance                                  after#0
        v-store after#0
        byte "box"                                   "box"
        byte 0x02                                    "box",0x02
        box_put
        v-load after#0                               after#0
        v-load before#0                              after#0,before#0
        >                                            tmp%16#0
        v-store tmp%16#0
        v-load tmp%16#0                              tmp%16#0
        assert // minimum balance follows the box
        byte "box"                                   "box"
        box_del                                      {box_del}
        pop 1
        b main_after_if_else@8

    main_after_if_else@8:
        v-load which#0                               which#0
        int 3                                        which#0,3
        ==                                           tmp%17#0
        v-store tmp%17#0
        v-load tmp%17#0                              tmp%17#0
        bz main_after_if_else@10 ; b main_if_body@9

    main_if_body@9:
        byte "busy"                                  "busy"
        int 1                                        "busy",1
        app_global_put
        itxn_begin
        int 1                                        1
        itxn_field TypeEnum
        txn Sender                                   tmp%18#0
        v-store tmp%18#0
        v-load tmp%18#0                              tmp%18#0
        itxn_field Receiver
        itxn_submit
        byte "busy"                                  "busy"
        int 0                                        "busy",0
        app_global_put
        b main_after_if_else@10

    main_after_if_else@10:
        v-load which#0                               which#0
        int 4                                        which#0,4
        ==                                           tmp%19#0
        v-store tmp%19#0
        v-load tmp%19#0                              tmp%19#0
        bz main_after_if_else@12 ; b main_if_body@11

    main_if_body@11:
        txna ApplicationArgs 2                       tmp%20#0
        v-store tmp%20#0
        byte "busy"                                  "busy"
        v-load tmp%20#0                              "busy",tmp%20#0
        app_global_put
        byte "busy"                                  "busy"
        int 0                                        "busy",0
        app_global_put
        b main_after_if_else@12

    main_after_if_else@12:
        v-load which#0                               which#0
        int 5                                        which#0,5
        ==                                           tmp%21#0
        v-store tmp%21#0
        v-load tmp%21#0                              tmp%21#0
        bz main_after_if_else@14 ; b main_if_body@13

    main_if_body@13:
        byte "busy"                                  "busy"
        int 0                                        "busy",0
        app_global_put
        b main_after_if_else@14

    main_after_if_else@14:
        int 1                                        1
        return


