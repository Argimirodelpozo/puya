// Op                                                Stack (out)
// Effects::UnobservedWrites.approvalProgram() -> uint64:
subroutine main:
    declare uint64 x#0
    main_block@0:                                    (𝕗) x#0 |
        txn ApplicationID                            (𝕗) x#0 | tmp%0#0
        bz main_if_body@1 ; b main_after_if_else@2   (𝕗) x#0 |

    main_if_body@1:                                  (𝕗) x#0 |
        int 1                                        (𝕗) x#0 | 1
        return                                       (𝕗) x#0 |

    main_after_if_else@2:                            (𝕗) x#0 |
        txna ApplicationArgs 0                       (𝕗) x#0 | tmp%2#0
        btoi                                         (𝕗) x#0 | which#0
        l-store-copy which#0 0                       (𝕗) x#0 | which#0,which#0
        x-store which#0                              (𝕗) x#0 | (𝕏) which#0 | which#0
        txna ApplicationArgs 1                       (𝕗) x#0 | (𝕏) which#0 | which#0,tmp%4#0
        btoi                                         (𝕗) x#0 | (𝕏) which#0 | which#0,x#0
        f-store x#0                                  (𝕗) x#0 | (𝕏) which#0 | which#0
        l-load which#0 0                             (𝕗) x#0 | (𝕏) which#0 | which#0
        bz main_if_body@3 ; b main_after_if_else@4   (𝕗) x#0 | (𝕏) which#0 |

    main_if_body@3:                                  (𝕗) x#0 | (𝕏) which#0 |
        byte "box"                                   (𝕗) x#0 | (𝕏) which#0 | "box"
        byte 0x01                                    (𝕗) x#0 | (𝕏) which#0 | "box",0x01
        box_put                                      (𝕗) x#0 | (𝕏) which#0 |
        byte "box"                                   (𝕗) x#0 | (𝕏) which#0 | "box"
        byte 0x0202                                  (𝕗) x#0 | (𝕏) which#0 | "box",0x0202
        box_put                                      (𝕗) x#0 | (𝕏) which#0 |
        b main_after_if_else@4                       (𝕗) x#0 | (𝕏) which#0 |

    main_after_if_else@4:                            (𝕗) x#0 | (𝕏) which#0 |
        x-load-copy which#0                          (𝕗) x#0 | (𝕏) which#0 | which#0 (copy)
        int 1                                        (𝕗) x#0 | (𝕏) which#0 | which#0 (copy),1
        ==                                           (𝕗) x#0 | (𝕏) which#0 | tmp%7#0
        bz main_after_if_else@6 ; b main_if_body@5   (𝕗) x#0 | (𝕏) which#0 |

    main_if_body@5:                                  (𝕗) x#0 | (𝕏) which#0 |
        f-load x#0                                   (𝕗) x#0 | (𝕏) which#0 | x#0
        int 2                                        (𝕗) x#0 | (𝕏) which#0 | x#0,2
        /                                            (𝕗) x#0 | (𝕏) which#0 | tmp%9#0
        itob                                         (𝕗) x#0 | (𝕏) which#0 | tmp%10#0
        byte "box"                                   (𝕗) x#0 | (𝕏) which#0 | tmp%10#0,"box"
        l-load tmp%10#0 1                            (𝕗) x#0 | (𝕏) which#0 | "box",tmp%10#0
        box_put                                      (𝕗) x#0 | (𝕏) which#0 |
        byte "box"                                   (𝕗) x#0 | (𝕏) which#0 | "box"
        box_del                                      (𝕗) x#0 | (𝕏) which#0 | {box_del}
        pop 1                                        (𝕗) x#0 | (𝕏) which#0 |
        b main_after_if_else@6                       (𝕗) x#0 | (𝕏) which#0 |

    main_after_if_else@6:                            (𝕗) x#0 | (𝕏) which#0 |
        x-load-copy which#0                          (𝕗) x#0 | (𝕏) which#0 | which#0 (copy)
        int 2                                        (𝕗) x#0 | (𝕏) which#0 | which#0 (copy),2
        ==                                           (𝕗) x#0 | (𝕏) which#0 | tmp%11#0
        bz main_after_if_else@8 ; b main_if_body@7   (𝕗) x#0 | (𝕏) which#0 |

    main_if_body@7:                                  (𝕗) x#0 | (𝕏) which#0 |
        global CurrentApplicationAddress             (𝕗) x#0 | (𝕏) which#0 | tmp%12#0
        min_balance                                  (𝕗) x#0 | (𝕏) which#0 | before#0
        byte "box"                                   (𝕗) x#0 | (𝕏) which#0 | before#0,"box"
        byte 0x01                                    (𝕗) x#0 | (𝕏) which#0 | before#0,"box",0x01
        box_put                                      (𝕗) x#0 | (𝕏) which#0 | before#0
        global CurrentApplicationAddress             (𝕗) x#0 | (𝕏) which#0 | before#0,tmp%14#0
        min_balance                                  (𝕗) x#0 | (𝕏) which#0 | before#0,after#0
        byte "box"                                   (𝕗) x#0 | (𝕏) which#0 | before#0,after#0,"box"
        byte 0x02                                    (𝕗) x#0 | (𝕏) which#0 | before#0,after#0,"box",0x02
        box_put                                      (𝕗) x#0 | (𝕏) which#0 | before#0,after#0
        l-load after#0 0                             (𝕗) x#0 | (𝕏) which#0 | before#0,after#0
        l-load before#0 1                            (𝕗) x#0 | (𝕏) which#0 | after#0,before#0
        >                                            (𝕗) x#0 | (𝕏) which#0 | tmp%16#0
        assert // minimum balance follows the box    (𝕗) x#0 | (𝕏) which#0 |
        byte "box"                                   (𝕗) x#0 | (𝕏) which#0 | "box"
        box_del                                      (𝕗) x#0 | (𝕏) which#0 | {box_del}
        pop 1                                        (𝕗) x#0 | (𝕏) which#0 |
        b main_after_if_else@8                       (𝕗) x#0 | (𝕏) which#0 |

    main_after_if_else@8:                            (𝕗) x#0 | (𝕏) which#0 |
        x-load-copy which#0                          (𝕗) x#0 | (𝕏) which#0 | which#0 (copy)
        int 3                                        (𝕗) x#0 | (𝕏) which#0 | which#0 (copy),3
        ==                                           (𝕗) x#0 | (𝕏) which#0 | tmp%17#0
        bz main_after_if_else@10 ; b main_if_body@9  (𝕗) x#0 | (𝕏) which#0 |

    main_if_body@9:                                  (𝕗) x#0 | (𝕏) which#0 |
        byte "busy"                                  (𝕗) x#0 | (𝕏) which#0 | "busy"
        int 1                                        (𝕗) x#0 | (𝕏) which#0 | "busy",1
        app_global_put                               (𝕗) x#0 | (𝕏) which#0 |
        itxn_begin                                   (𝕗) x#0 | (𝕏) which#0 |
        int 1                                        (𝕗) x#0 | (𝕏) which#0 | 1
        itxn_field TypeEnum                          (𝕗) x#0 | (𝕏) which#0 |
        txn Sender                                   (𝕗) x#0 | (𝕏) which#0 | tmp%18#0
        itxn_field Receiver                          (𝕗) x#0 | (𝕏) which#0 |
        itxn_submit                                  (𝕗) x#0 | (𝕏) which#0 |
        byte "busy"                                  (𝕗) x#0 | (𝕏) which#0 | "busy"
        int 0                                        (𝕗) x#0 | (𝕏) which#0 | "busy",0
        app_global_put                               (𝕗) x#0 | (𝕏) which#0 |
        b main_after_if_else@10                      (𝕗) x#0 | (𝕏) which#0 |

    main_after_if_else@10:                           (𝕗) x#0 | (𝕏) which#0 |
        x-load-copy which#0                          (𝕗) x#0 | (𝕏) which#0 | which#0 (copy)
        int 4                                        (𝕗) x#0 | (𝕏) which#0 | which#0 (copy),4
        ==                                           (𝕗) x#0 | (𝕏) which#0 | tmp%19#0
        bz main_after_if_else@12 ; b main_if_body@11 (𝕗) x#0 | (𝕏) which#0 |

    main_if_body@11:                                 (𝕗) x#0 | (𝕏) which#0 |
        txna ApplicationArgs 2                       (𝕗) x#0 | (𝕏) which#0 | tmp%20#0
        byte "busy"                                  (𝕗) x#0 | (𝕏) which#0 | tmp%20#0,"busy"
        l-load tmp%20#0 1                            (𝕗) x#0 | (𝕏) which#0 | "busy",tmp%20#0
        app_global_put                               (𝕗) x#0 | (𝕏) which#0 |
        byte "busy"                                  (𝕗) x#0 | (𝕏) which#0 | "busy"
        int 0                                        (𝕗) x#0 | (𝕏) which#0 | "busy",0
        app_global_put                               (𝕗) x#0 | (𝕏) which#0 |
        b main_after_if_else@12                      (𝕗) x#0 | (𝕏) which#0 |

    main_after_if_else@12:                           (𝕗) x#0 | (𝕏) which#0 |
        x-load which#0                               (𝕗) x#0 | which#0
        int 5                                        (𝕗) x#0 | which#0,5
        ==                                           (𝕗) x#0 | tmp%21#0
        bz main_after_if_else@14 ; b main_if_body@13 (𝕗) x#0 |

    main_if_body@13:                                 (𝕗) x#0 |
        byte "busy"                                  (𝕗) x#0 | "busy"
        int 0                                        (𝕗) x#0 | "busy",0
        app_global_put                               (𝕗) x#0 |
        b main_after_if_else@14                      (𝕗) x#0 |

    main_after_if_else@14:                           (𝕗) x#0 |
        int 1                                        (𝕗) x#0 | 1
        return                                       (𝕗) x#0 |


