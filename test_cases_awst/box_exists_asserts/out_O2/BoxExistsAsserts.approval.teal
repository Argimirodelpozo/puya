#pragma version 11
#pragma typetrack false

// Effects::BoxExistsAsserts.approvalProgram() -> uint64:
main:
    intcblock 8 1
    bytecblock "box"
    txn ApplicationID
    bnz main_after_if_else@2

main_if_body@1:
    intc_1 // 1
    return

main_after_if_else@2:
    txna ApplicationArgs 0
    btoi
    dup
    bnz main_after_if_else@4
    bytec_0 // "box"
    intc_0 // 8
    box_create
    pop
    bytec_0 // "box"
    box_del
    pop
    bytec_0 // "box"
    box_len
    bury 1
    assert // box exists after box_del

main_after_if_else@4:
    dup
    intc_1 // 1
    ==
    bz main_after_if_else@6
    bytec_0 // "box"
    box_len
    bury 1
    bytec_0 // "box"
    intc_0 // 8
    box_create
    pop
    assert // box existed before box_create

main_after_if_else@6:
    dup
    pushint 2
    ==
    bz main_after_if_else@8
    bytec_0 // "box"
    intc_0 // 8
    box_create
    pop
    itxn_begin
    intc_1 // 1
    itxn_field TypeEnum
    txn Sender
    itxn_field Receiver
    itxn_submit
    bytec_0 // "box"
    box_len
    bury 1
    assert // box exists after inner transaction
    bytec_0 // "box"
    box_del
    pop

main_after_if_else@8:
    pushint 3
    ==
    bz main_if_body@1
    bytec_0 // "box"
    intc_0 // 8
    box_create
    pop
    bytec_0 // "box"
    box_del
    pop
    b main_if_body@1
