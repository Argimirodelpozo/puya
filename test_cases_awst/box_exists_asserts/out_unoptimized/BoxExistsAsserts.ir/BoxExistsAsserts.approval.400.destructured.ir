main Effects::BoxExistsAsserts.approvalProgram:
    block@0: // L1
        let tmp%0#0: uint64 = (txn ApplicationID)
        let tmp%1#0: bool = (== tmp%0#0 0u)
        goto tmp%1#0 ? block@1 : block@2
    block@1: // if_body_L1
        return 1u
    block@2: // after_if_else_L1
        let tmp%2#0: bytes = (txna ApplicationArgs 0)
        let tmp%3#0: uint64 = (btoi tmp%2#0)
        let which#0: uint64 = tmp%3#0
        let tmp%4#0: bool = (== which#0 0u)
        goto tmp%4#0 ? block@3 : block@4
    block@3: // if_body_L1
        (box_create "box" 8u)
        let (tmp%5#0: uint64, tmp%6#0: bool) = (box_len "box")
        let existed#0: bool = tmp%6#0
        (box_del "box")
        (assert existed#0) // box existed
        let (tmp%7#0: uint64, tmp%8#0: bool) = (box_len "box")
        (assert tmp%8#0) // box exists after box_del
        goto block@4
    block@4: // after_if_else_L1
        let tmp%9#0: bool = (== which#0 1u)
        goto tmp%9#0 ? block@5 : block@6
    block@5: // if_body_L1
        let (tmp%10#0: uint64, tmp%11#0: bool) = (box_len "box")
        let existed#0: bool = tmp%11#0
        (box_create "box" 8u)
        (assert existed#0) // box existed before box_create
        goto block@6
    block@6: // after_if_else_L1
        let tmp%12#0: bool = (== which#0 2u)
        goto tmp%12#0 ? block@7 : block@8
    block@7: // if_body_L1
        (box_create "box" 8u)
        itxn_begin
        ((itxn_field TypeEnum) 1u)
        let tmp%13#0: account = (txn Sender)
        ((itxn_field Receiver) tmp%13#0)
        itxn_submit
        let (tmp%14#0: uint64, tmp%15#0: bool) = (box_len "box")
        (assert tmp%15#0) // box exists after inner transaction
        (box_del "box")
        goto block@8
    block@8: // after_if_else_L1
        let tmp%16#0: bool = (== which#0 3u)
        goto tmp%16#0 ? block@9 : block@10
    block@9: // if_body_L1
        (box_create "box" 8u)
        let (tmp%17#0: uint64, tmp%18#0: bool) = (box_len "box")
        (assert tmp%18#0) // box exists after box_create
        (box_del "box")
        goto block@10
    block@10: // after_if_else_L1
        return 1u