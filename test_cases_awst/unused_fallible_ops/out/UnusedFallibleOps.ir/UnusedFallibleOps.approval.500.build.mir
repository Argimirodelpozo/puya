// Op                                                Stack (out)
// Effects::UnusedFallibleOps.approvalProgram() -> uint64:
subroutine main:
    main_block@0:
        txna ApplicationArgs 0                       tmp%0#0
        v-store tmp%0#0
        v-load tmp%0#0                               tmp%0#0
        btoi                                         which#0
        v-store which#0
        txna ApplicationArgs 1                       tmp%2#0
        v-store tmp%2#0
        v-load tmp%2#0                               tmp%2#0
        btoi                                         x#0
        v-store x#0
        txna ApplicationArgs 2                       tmp%4#0
        v-store tmp%4#0
        v-load tmp%4#0                               tmp%4#0
        btoi                                         y#0
        v-store y#0
        v-load which#0                               which#0
        bz main_if_body@1 ; b main_after_if_else@2

    main_if_body@1:
        v-load x#0                                   x#0
        v-load y#0                                   x#0,y#0
        -                                            {-}
        pop 1
        b main_after_if_else@2

    main_after_if_else@2:
        v-load which#0                               which#0
        int 1                                        which#0,1
        ==                                           tmp%7#0
        v-store tmp%7#0
        v-load tmp%7#0                               tmp%7#0
        bz main_after_if_else@4 ; b main_if_body@3

    main_if_body@3:
        v-load x#0                                   x#0
        v-load y#0                                   x#0,y#0
        +                                            {+}
        pop 1
        b main_after_if_else@4

    main_after_if_else@4:
        v-load which#0                               which#0
        int 2                                        which#0,2
        ==                                           tmp%8#0
        v-store tmp%8#0
        v-load tmp%8#0                               tmp%8#0
        bz main_after_if_else@6 ; b main_if_body@5

    main_if_body@5:
        v-load x#0                                   x#0
        v-load y#0                                   x#0,y#0
        *                                            unused#0
        v-store unused#0
        b main_after_if_else@6

    main_after_if_else@6:
        v-load which#0                               which#0
        int 3                                        which#0,3
        ==                                           tmp%10#0
        v-store tmp%10#0
        v-load tmp%10#0                              tmp%10#0
        bz main_after_if_else@8 ; b main_if_body@7

    main_if_body@7:
        v-load x#0                                   x#0
        v-load y#0                                   x#0,y#0
        exp                                          {exp}
        pop 1
        b main_after_if_else@8

    main_after_if_else@8:
        v-load which#0                               which#0
        int 4                                        which#0,4
        ==                                           tmp%11#0
        v-store tmp%11#0
        v-load tmp%11#0                              tmp%11#0
        bz main_after_if_else@10 ; b main_if_body@9

    main_if_body@9:
        v-load x#0                                   x#0
        v-load y#0                                   x#0,y#0
        /                                            {/}
        pop 1
        b main_after_if_else@10

    main_after_if_else@10:
        v-load which#0                               which#0
        int 5                                        which#0,5
        ==                                           tmp%12#0
        v-store tmp%12#0
        v-load tmp%12#0                              tmp%12#0
        bz main_after_if_else@12 ; b main_if_body@11

    main_if_body@11:
        v-load x#0                                   x#0
        v-load y#0                                   x#0,y#0
        shl                                          {shl}
        pop 1
        b main_after_if_else@12

    main_after_if_else@12:
        v-load which#0                               which#0
        int 6                                        which#0,6
        ==                                           tmp%13#0
        v-store tmp%13#0
        v-load tmp%13#0                              tmp%13#0
        bz main_after_if_else@14 ; b main_if_body@13

    main_if_body@13:
        txna ApplicationArgs 3                       tmp%14#0
        v-store tmp%14#0
        v-load tmp%14#0                              tmp%14#0
        btoi                                         {btoi}
        pop 1
        b main_after_if_else@14

    main_after_if_else@14:
        v-load which#0                               which#0
        int 7                                        which#0,7
        ==                                           tmp%15#0
        v-store tmp%15#0
        v-load tmp%15#0                              tmp%15#0
        bz main_after_if_else@16 ; b main_if_body@15

    main_if_body@15:
        txna ApplicationArgs 3                       tmp%16#0
        v-store tmp%16#0
        v-load tmp%16#0                              tmp%16#0
        v-load x#0                                   tmp%16#0,x#0
        v-load y#0                                   tmp%16#0,x#0,y#0
        extract3                                     {extract3}
        pop 1
        b main_after_if_else@16

    main_after_if_else@16:
        v-load which#0                               which#0
        int 8                                        which#0,8
        ==                                           tmp%17#0
        v-store tmp%17#0
        v-load tmp%17#0                              tmp%17#0
        bz main_after_if_else@18 ; b main_if_body@17

    main_if_body@17:
        txna ApplicationArgs 3                       tmp%18#0
        v-store tmp%18#0
        txna ApplicationArgs 3                       tmp%19#0
        v-store tmp%19#0
        v-load tmp%18#0                              tmp%18#0
        v-load tmp%19#0                              tmp%18#0,tmp%19#0
        b+                                           {b+}
        pop 1
        b main_after_if_else@18

    main_after_if_else@18:
        int 1                                        1
        return


